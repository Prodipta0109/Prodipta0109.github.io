@inproceedings{amartya2024interval,
  title     = {An Interval Creation Approach to Construct Interval Type-2 Fuzzy Sets},
  author    = {Amartya, Prodipta Sen and Kabir, Shaily and Karmaker Babu, Sagar Chandra and Jahan, Mosarrat},
  booktitle = {2024 IEEE International Conference on Fuzzy Systems (FUZZ-IEEE)},
  year      = {2024},
  publisher = {IEEE},
  note      = {Presented at the 2024 IEEE World Congress on Computational Intelligence (WCCI)},
  abstract  = {We propose the Interval Creation Approach (ICA), a method for constructing interval type-2 fuzzy sets from a variety of type-1 fuzzy set shapes, including triangular, trapezoidal, Gaussian, and generalized bell-shaped curves in both symmetric and asymmetric forms. ICA is evaluated against the Interval Approach, the Enhanced Interval Approach, and the M2 method on synthetic and real-world datasets, reducing pre-processing time and improving overall computational cost.},
  selected  = {true}
}
