@inproceedings{amartya2024interval,
  title     = {An Interval Creation Approach to Construct Interval Type-2 Fuzzy Sets},
  author    = {Amartya, Prodipta Sen and Kabir, Shaily and Karmaker Babu, Sagar Chandra and Jahan, Mosarrat},
  booktitle = {2024 IEEE International Conference on Fuzzy Systems (FUZZ-IEEE)},
  year      = {2024},
  publisher = {IEEE},
  html      = {https://ieeexplore.ieee.org/abstract/document/10611950},
  note      = {Presented at the 2024 IEEE World Congress on Computational Intelligence (WCCI)},
  abstract  = {Interval type-2 fuzzy sets (IT2 FSs) are more popular over type-1 fuzzy sets (T1 FSs) as they capture uncertainty in a better way in many real-world problems. Modelling uncertainty with an IT2 FS is relatively complex and solely depends on how to define its Footprint of Uncertainty (FOU)-an uncertainty region of IT2 FS bounded by its lower and upper membership functions. Existing methods either transform existing T1 FSs to IT2 FSs or design IT2 FSs from input data, captured by interval via constructing T1 FSs. In both cases, they require additional processing step and computational time and thus not useful for time-sensitive applications (e.g., intelligent transportation systems, online recommendation systems). To address this limitation, this paper puts forward a simple approach, termed as 'Interval Creation Approach' (ICA) to design IT2 FSs directly from the input data. Further, it is designed to work equally well for transforming existing T1 FS into IT2 FS. The new approach skips data preprocessing phase and the creation of T1 FS as an intermediary to define the FOU of the IT2 FS, thus contributing to faster execution. The paper provides a description of the ICA along with a comparison of its effectiveness against the state-of-the-art methods using both synthetic and real-world data sets.},
  preview = {wcci2024.png},
  selected  = {true}
}

@misc{imu2026cancerousbackdoorattackgradual,
  title={Cancerous Backdoor Attack: Gradual Activation via Invisible Tokens and A Stage Controller}, 
  author={Tahmid Imtiaz Imu and Emama Nahid and Prodipta Sen Amartya and Ahsanul Jobayer and Yutong Song and Jiang Wu and Pengfei Zhang and Honghui Xu},
  year={2026},
  eprint={2610.12644},
  archivePrefix={arXiv},
  primaryClass={cs.CR},
  preview={arxiv.jpg},
  note = {arXiv:2610.12644 [cs.CR]},
  html = {https://arxiv.org/abs/2610.12644},
  selected  = {true},
  abstract  = {Backdoor Attacks on Large Language Models (LLMs) typically follow a trigger-response pattern, where satisfying a trigger condition activates a single terminal behavior. However, this single-point backdoor activation does not explore attacks in which malicious behavior develops gradually through multiple intermediate stages before reaching the terminal activation stage. We present Cancerous Backdoor Attack, that gradually corrupts an LLM's reasoning over a sequence of interactions by leveraging invisible tokens and a stage controller. Specifically, invisible tokens provide hidden stages to the model without appearing in the user's visible request and the stage controller tracks the attack's progression during inference to realize gradual activation. We evaluate Cancerous Backdoor Attack across several reasoning datasets. The attack consistently produces gradual reasoning corruption across models and tasks. We compare Cancerous Backdoor Attack with prior backdoor attack baselines to demonstrate our proposed attack outperforms the baselines. Our results indicate that reasoning corruption can develop gradually before it becomes visible, making answer accuracy alone insufficient for detecting backdoor attacks.}
}